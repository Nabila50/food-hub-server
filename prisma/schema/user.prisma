model User {
  id            String    @id
  name          String
  email         String    @unique
  role          ROLE      @default(CUSTOMER)
  updatedAt     DateTime  @default(now()) @updatedAt
  createdAt     DateTime  @default(now())
  emailVerified Boolean?  @default(false)
  image         String?
  phone         String?
  status        String?   @default("ACTIVE")
  accounts      Account[]
  provider      Provider?
  sessions      Session[]
  order         Order[]
}

enum ROLE {
  CUSTOMER
  PROVIDER
  ADMIN
}